---
import ShowLayout from '../layouts/ShowLayout.astro';
import ShowBanner from '../components/show/ShowBanner.astro';
import ShowSynopsis from '../components/show/ShowSynopsis.astro';
import ShowDistribution from '../components/show/ShowDistribution.astro';
import ShowGallery from '../components/show/ShowGallery.astro';

const galleryPhotos = [
  { src: "images/la_page_blanche/la-page-blanche-troupe.jpg", alt: "La Page Blanche Troupe", credit: "© Peter Gunnar" },
  { src: "images/la_page_blanche/la-page-blanche-gallery-1.jpeg", alt: "La Page Blanche Gallery 1", credit: "© Peter Gunnar" },
  { src: "images/la_page_blanche/la-page-blanche-gallery-2.jpeg", alt: "La Page Blanche Gallery 2", credit: "© Peter Gunnar" },
  // TODO: change image aspect to add vertical images to gallery
  // { src: "images/la_page_blanche/la-page-blanche-gallery-3.jpeg", alt: "La Page Blanche Gallery 3", credit: "© Peter Gunnar" },
];
---

<ShowLayout title="La Page Blanche - Dancing Through Life">
  <ShowBanner image="images/la_page_blanche/la-page-blanche-banner.jpg" title="LA PAGE BLANCHE" year="2026" credit="" />

  <ShowSynopsis poster="images/la_page_blanche/la-page-blanche.jpg" posterAlt="Affiche du spectacle La Page Blanche">
    <p>
      L'Auteur tient tant bien que mal dans son bateau qui prend l'eau. Il garde
      le cap. Il s'acharne sur ce qu'il doit faire, sur ce qu'il devrait savoir
      faire, écrire sa prochaine comédie musicale.
    </p>
    <p>
      Une pièce "trop déprimante" dira le Producteur. Envahi par ses démons,
      l'Auteur n'arrive plus qu'à écrire sa douleur. Pourtant, il était
      lumineux avant tout ça, et ses pièces aussi....
    </p>
    <p>
      Alors, comment continuer de créer dans un monde qui semble avoir perdu
      tout son sens ?
    </p>
  </ShowSynopsis>

  <ShowDistribution>
    <h3>SUR SCENE</h3><br />
    <p>
      <strong>L'Auteur :</strong> Elohan-Louis Lanier<br />
      <strong>Esmée :</strong> Juliette Ferragu<br />
      <strong>Augustin :</strong> Freddy Phung<br />
      <strong>L'Amie :</strong> Floriane Dieuleveut<br />
      <strong>La Serveuse :</strong> Pauline Fredouelle-Volokh<br />
      <strong>Le Producteur :</strong> Taha Mansour<br />
      <strong>Choeurs et danseurs :</strong> Elise Devey (L'Assistante du Producteur), Alix Lesaulnier (Serveuse 2), 
      Fanny Mathieux (Serveuse 3), Martha Dro (Serveuse 4), Claire Helaine (Serveuse 5), Achille Huet (L'Autre), 
      Lucie Clemot (Liza), Suzanne Martin (Un Personnage), Mario Liere (Méchant), Valentine Dérue, Iona Serquin, 
      Martin Henin, Armel Chausse, Alix Planchon<br />
    </p>
    <br />
    <p><strong>Orchestre :</strong> Jean Renaud, Gabriel Villaret, Adrien Villaret, Victor Fournier, Louis Kelley, Camille Lançon<br /></p>
    <br />
    <h3>EQUIPE ARTISTIQUE</h3><br />
    <p>
      <strong>Ecriture & Direction Artistique :</strong> Sarah Baranes<br/>
      assistée par Alix Lesaulnier<br />
      <strong>Mise en scène & direction d’acteurs :</strong> Sarah Baranes et Blanche Rivière<br />
      <strong>Danse :</strong> Pauline Charvet<br />
      avec l’aide de Armel Chausse et la participation de Pauline Fredouelle-Volokh<br />
      <strong>Chant :</strong> Freddy Phung <br />
      avec l’aide de Elohan-Louis Lanier, Achille Huet, Claire Helaine, Valentine Dérue, Sarah Baranes, 
      Lucie Clemot, Juliette Ferragu, Fanny Mathieux<br />
      <strong>Direction Orchestre :</strong> Guillaume Villaret, Freddy Phung<br />
      <strong>Lumières :</strong> Nina Bouvier Renaud<br />
      <strong>Décors & Costumes :</strong> Alice Roux, Thanh-Ha Le, Salomé Hacquet, Milena Markovic, 
      Alix Planchon, Margot Pouvesle, Alix Lesaulnier, Marie Lejeune, Cécile Guitteny, Sarah Baranes, Pauline Charvet, Léna Ulloa <br />
      sous la coordination de Sophie Lejeune<br />
    </p>
    <br />
    <h3>ORGANISATION</h3><br />
    <p>
      <strong>Président :</strong> Maxime Archambault<br />
      <strong>Secrétaire Générale :</strong> Marine De Backer<br />
      <strong>Vice-Présidente :</strong> Sophie Lejeune<br />
      <strong>Vice-Président :</strong> Yassine Terrab<br />
      <strong>Trésorière :</strong> Fanny Mathieux<br />
      <strong>Vice-Trésorier :</strong> Achille Huet<br />
    </p>
    <br />
    <p><strong>Communication :</strong> Lucie Clemot, Martha Dro, Valentine Dérue, Iona Serquin</p>
  </ShowDistribution>

  <ShowGallery photos={galleryPhotos} />
</ShowLayout>
