---
import ShowLayout from '../layouts/ShowLayout.astro';
import ShowBanner from '../components/show/ShowBanner.astro';
import ShowSynopsis from '../components/show/ShowSynopsis.astro';
import ShowDistribution from '../components/show/ShowDistribution.astro';
import ShowGallery from '../components/show/ShowGallery.astro';
import ShowVideo from '../components/show/ShowVideo.astro';
import TroopPhotos from '../components/show/TroopPhotos.astro';

const firstYearStudents = [
  { src: "images/apnee/troop-emilie.jpg", alt: "Emilie - Lucie Clemot", role: "Emilie", actor: "Lucie Clemot" },
  { src: "images/apnee/troop-gabriel.jpg", alt: "Gabriel - Teva Pouillet", role: "Gabriel", actor: "Teva Pouillet" },
  { src: "images/apnee/troop-salome.jpg", alt: "Salome - Faustine Malatray", role: "Salome", actor: "Faustine Malatray" },
  { src: "images/apnee/troop-arthur.jpg", alt: "Arthur - Naoufal Alami Hassani", role: "Arthur", actor: "Naoufal Alami Hassani" },
  { src: "images/apnee/troop-daphnee.jpg", alt: "Daphnee - Juliette Ferragu", role: "Daphnee", actor: "Juliette Ferragu" },
  { src: "images/apnee/troop-louis.jpg", alt: "Louis - Achille Huet", role: "Louis", actor: "Achille Huet" },
  { src: "images/apnee/troop-heloise.jpg", alt: "Heloise - Sophie Lejeune", role: "Heloise", actor: "Sophie Lejeune" },
];
const secondYearStudents = [
  { src: "images/apnee/troop-lili.jpg", alt: "Lili - Marianne Clary", role: "Lili", actor: "Marianne Clary" },
  { src: "images/apnee/troop-theo.jpg", alt: "Théo - Maxime Archambault", role: "Théo", actor: "Maxime Archambault" },
  { src: "images/apnee/troop-clemence.jpg", alt: "Clemence - Elise Desbordes", role: "Clemence", actor: "Elise Desbordes" },
  { src: "images/apnee/troop-margot.jpg", alt: "Margot - Pauline Fredouelle Volokh", role: "Margot", actor: "Pauline Fredouelle Volokh" },
  { src: "images/apnee/troop-bastien.jpg", alt: "Bastien - Yanis Trouyet", role: "Bastien", actor: "Yanis Trouyet" },
  { src: "images/apnee/troop-emmanuelle.jpg", alt: "Emmanuelle - Elise Devey", role: "Emmanuelle", actor: "Elise Devey" },
  { src: "images/apnee/troop-mr-mayer.jpg", alt: "Mr. Mayer - Gautier Creutzer", role: "Mr. Mayer", actor: "Gautier Creutzer" },
  { src: "images/apnee/troop-mr-atibe.jpg", alt: "Mr. Atibe - Mehdi Reuillon", role: "Mr. Atibe", actor: "Mehdi Reuillon" },
];

const galleryPhotos = [
  { src: "images/apnee/apnee-gallery-1.jpg", alt: "Apnée Gallery 1", credit: "© Peter Gunnar" },
  { src: "images/apnee/apnee-gallery-2.jpg", alt: "Apnée Gallery 2", credit: "© Peter Gunnar" },
  { src: "images/apnee/apnee-gallery-3.jpg", alt: "Apnée Gallery 3", credit: "© Peter Gunnar" },
  { src: "images/apnee/apnee-gallery-5.jpg", alt: "Apnée Gallery 5", credit: "© Peter Gunnar" },
];
---

<ShowLayout title="Apnée - Dancing Through Life">
  <ShowBanner image="images/apnee/apnee-banner.jpg" title="APNEE" year="2025" credit="© Peter Gunnar" />

  <ShowSynopsis poster="images/apnee/apnee.jpg" posterAlt="Affiche du spectacle Apnée">
    <p>
      Lorsque Lili et Émilie ont rejoint l'une des universités les plus
      prestigieuses, elles étaient loin de se douter que l'amour viendrait
      bouleverser leur parcours. Mais peut-on toujours être sûr que ce que
      l'on nomme « amour » en est réellement un ?
    </p>
    <p>
      Au rythme effréné de la vie universitaire, amitiés naissantes, nuits
      festives et premiers grands choix de l'âge adulte, les deux protagonistes
      devront trouver le courage de ne pas s'oublier.
    </p>
    <p>
      Entre moments de joie, doutes et drames, une chose reste constante :
      la musique, qui révèle ce que les mots n'osent pas dire.
    </p>
  </ShowSynopsis>

  <ShowVideo url="https://youtube.com/embed/ScjZBHD_1ZU?si=m3yK289BL9YUTLYs" title="Apnée - Trailer" />

  <ShowDistribution>
    <div slot="before-text" style="max-width: 80%; margin: 0 auto;">
      <h3 class="troop-section-title">Elèves - 1ère année</h3><br />
      <TroopPhotos maxPerRow={5} minWidth={120} members={firstYearStudents} />
      <h3 class="troop-section-title">Elèves - 2ème année</h3><br />
      <TroopPhotos maxPerRow={5} minWidth={120} members={secondYearStudents} />
    </div>
    
    <p><strong>Sur scène :</strong> Anaëlle Breton,
      Hugo Goasdoué, Suzanne Martin, Lisa Mollo, Alix Planchon, Iona Serquin,
      Valentine Derue, Floriane Dieuleveut, Martha Dro, Claire Helaine, Mario Liere,
      Fanny Mathieu, Freddy Phung et Yassine Terrab</p>
    <br />
    <p><strong>Orchestre :</strong> Alexandre Dareau, Jean Renaud, Gabriel Villaret
      et Bruno Ximenez</p>
    <br />
    <p><strong>Livret et direction artistique :</strong> Marine De Backer</p>
    <p><strong>Mise en scène :</strong> Marine De Backer et Alexandre Pierre</p>
    <p><strong>Direction musicale :</strong> Guillaume Villaret<br />
      avec le soutien de Sarah Baranes, Hugo Borsoni, Lucie Clemot, Claire Helaine,
      Achille Huet, Lisa Mollo et Freddy Phung</p>
    <p><strong>Chorégraphies :</strong> Armel Chausse et Mathilde Lavanant<br />
      avec le soutien d'Anaëlle Breton, Hugo Goasdoué et Pauline Fredouelle Volokh</p>
    <p><strong>Décors et Costumes :</strong> Aloïs Deconinck, Marie Lejeune, Alix Lesaulnier, Faustine Malatray, Alix Planchon et Tanguy Olympie</p>
    <p><strong>Lumières :</strong> Marine De Backer, Alexandre Pierre et Nina Bouvier Renaud</p>
    <p><strong>Communication :</strong> Lucie Clemot, Marianne Clary, Martha Dro, Pauline Fredouelle Volokh, Lisa Mollo, Teva Pouillet et Iona Serquin</p>
    <br />
    <p><strong>Bureau :</strong><br />
      Président : Gautier Creutzer<br />
      Vice-présidente : Sarah Baranes<br />
      Secrétaire Générale : Sophie Lejeune<br />
      Trésorier : Adrien Gourmellet<br />
      Vice-trésorière : Fanny Mathieu</p>

    </ShowDistribution>

  <ShowGallery photos={galleryPhotos} />
</ShowLayout>
